MONGO_URI=mongodb://127.0.0.1:27017/wedding_qr

# Port this API listens on
PORT=47311

# Host + port of the frontend, used when baking verify URLs into QR codes
HOST_IP=192.168.0.108
FRONTEND_PORT=47312

# Shared staff password for the pass manager. Everything that can create, list,
# download or reset passes requires it, sent as the `x-admin-key` header.
# With this unset, those routes fail closed (503) and nobody can sign in.
ADMIN_KEY=change-me-before-deploying
